# Server Configuration
DEEPSEEK_SERVER_PORT=8765
DEEPSEEK_STORAGE_DIR=~/.deepseek-copier
DEEPSEEK_DEFAULT_IDE=auto

# Feature Flags
DEEPSEEK_ENABLE_VERSIONING=true
DEEPSEEK_ENABLE_ERROR_TRACKING=true
DEEPSEEK_LOG_LEVEL=INFO

# Security
DEEPSEEK_SECRET_KEY=your-secret-key-here

# Infrastructure
REDIS_URL=redis://localhost:6379
DATABASE_URL=sqlite:///deepseek.db
