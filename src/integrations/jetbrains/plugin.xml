<idea-plugin>
    <id>com.nj-ide-copier</id>
    <name>NJ IDE Copier</name>
    <version>2.0.0</version>
    <vendor>NJ IDE Copier Team</vendor>
    <description><![CDATA[
        Copy code from DeepSeek AI chat directly into JetBrains IDEs
        with version tracking and error detection.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <actions>
        <action id="NJIDECopier.InsertCode"
                class="com.njidecopier.actions.InsertCodeAction"
                text="NJ IDE Copier: Insert Code"
                description="Insert code from DeepSeek at cursor">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="NJIDECopier.ShowHistory"
                class="com.njidecopier.actions.ShowHistoryAction"
                text="NJ IDE Copier: Version History"
                description="Show code version history">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
    <applicationListeners>
        <listener class="com.njidecopier.listeners.ServerListener"
                  topic="com.intellij.openapi.application.Application"/>
    </applicationListeners>
</idea-plugin>
